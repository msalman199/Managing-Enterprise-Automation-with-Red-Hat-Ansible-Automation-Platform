Task 2: Test Dynamic Inventories and Job Targeting
Subtask 2.1: Create Test Playbooks
Navigate to Projects and create a new project or use an existing one.

Create a simple test playbook. In your project directory, create test-smart-inventory.yml:

---
- name: Test Smart Inventory Targeting
  hosts: all
  gather_facts: yes
  tasks:
    - name: Display host information
      debug:
        msg: |
          Host: {{ inventory_hostname }}
          Server Type: {{ server_type | default('undefined') }}
          Environment: {{ environment | default('undefined') }}
          Region: {{ region | default('undefined') }}
          CPU Cores: {{ cpu_cores | default('undefined') }}
          Memory GB: {{ memory_gb | default('undefined') }}

    - name: Create identification file
      file:
        path: "/tmp/smart-inventory-test-{{ server_type | default('unknown') }}.txt"
        state: touch
        mode: '0644'
      become: yes

    - name: Write host details to file
      lineinfile:
        path: "/tmp/smart-inventory-test-{{ server_type | default('unknown') }}.txt"
        line: "{{ inventory_hostname }} - {{ ansible_date_time.iso8601 }}"
        create: yes
      become: yes
Create another playbook for testing specific server types, web-server-config.yml:
---
- name: Configure Web Servers
  hosts: all
  gather_facts: yes
  tasks:
    - name: Verify this is a web server
      assert:
        that:
          - server_type == "web"
        fail_msg: "This playbook should only run on web servers"
        success_msg: "Confirmed: This is a web server"

    - name: Install web server package (simulation)
      debug:
        msg: "Installing nginx on {{ inventory_hostname }}"

    - name: Configure web server
      copy:
        content: |
          # Web Server Configuration
          Server: {{ inventory_hostname }}
          Type: {{ server_type }}
          Region: {{ region }}
          Configured: {{ ansible_date_time.iso8601 }}
        dest: "/tmp/web-config-{{ inventory_hostname }}.conf"
      become: yes

    - name: Display web server status
      debug:
        msg: "Web server {{ inventory_hostname }} configured successfully"
