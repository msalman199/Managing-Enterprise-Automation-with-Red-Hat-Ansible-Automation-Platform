Subtask 1.2: Create a Sample Playbook
Connect to the AWX server via SSH:

ssh awx-user@your-awx-server-ip
Create a project directory for your playbooks:

sudo mkdir -p /var/lib/awx/projects/lab6-project
sudo chown awx:awx /var/lib/awx/projects/lab6-project
Create a comprehensive playbook for system configuration: ```bash sudo tee /var/lib/awx/projects/lab6-project/system-setup.yml > /dev/null << 'EOF'
name: System Configuration and Package Management hosts: all become: yes vars: packages_to_install: - htop - vim - curl - wget service_user: "webadmin"

tasks:

name: Update package cache yum: update_cache: yes tags: packages

name: Install required packages yum: name: "{{ packages_to_install }}" state: present tags: packages

name: Create service user user: name: "{{ service_user }}" shell: /bin/bash create_home: yes state: present tags: users

name: Create application directory file: path: /opt/myapp state: directory owner: "{{ service_user }}" group: "{{ service_user }}" mode: '0755' tags: directories

name: Copy configuration template copy: content: | # Application Configuration APP_NAME=MyApplication APP_VERSION=1.0 DEBUG=false LOG_LEVEL=info dest: /opt/myapp/config.env owner: "{{ service_user }}" group: "{{ service_user }}" mode: '0644' tags: config

name: Ensure firewalld is running systemd: name: firewalld state: started enabled: yes tags: services

handlers:

name: restart firewalld systemd: name: firewalld state: restarted
EOF


Set proper permissions on the playbook:

sudo chown awx:awx /var/lib/awx/projects/lab6-project/system-setup.yml
sudo chmod 644 /var/lib/awx/projects/lab6-project/system-setup.yml
