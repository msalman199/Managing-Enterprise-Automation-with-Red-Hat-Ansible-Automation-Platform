Subtask 2.3: Create AWS Dynamic Inventory Script
Create the dynamic inventory script:
nano aws_ec2_inventory.py
Add the following Python script:
#!/usr/bin/env python3

import json
import boto3
import sys
from botocore.exceptions import ClientError

def get_ec2_instances():
    """Retrieve EC2 instances and organize them into Ansible inventory format"""
    
    try:
        ec2 = boto3.client('ec2')
        response = ec2.describe_instances()
        
        inventory = {
            '_meta': {
                'hostvars': {}
            },
            'all': {
                'children': ['ungrouped']
            },
            'ungrouped': {
                'hosts': []
            }
        }
        
        # Group hosts by tags and instance state
        groups = {}
        
        for reservation in response['Reservations']:
            for instance in reservation['Instances']:
                if instance['State']['Name'] != 'running':
                    continue
                
                # Get instance details
                instance_id = instance['InstanceId']
                private_ip = instance.get('PrivateIpAddress', '')
                public_ip = instance.get('PublicIpAddress', '')
                instance_type = instance['InstanceType']
                
                # Use public IP if available, otherwise private IP
                host_ip = public_ip if public_ip else private_ip
                
                if not host_ip:
                    continue
                
                # Add to hostvars
                inventory['_meta']['hostvars'][host_ip] = {
                    'ansible_host': host_ip,
                    'ec2_instance_id': instance_id,
                    'ec2_instance_type': instance_type,
                    'ec2_private_ip': private_ip,
                    'ec2_public_ip': public_ip,
                    'ec2_state': instance['State']['Name']
                }
                
                # Process tags for grouping
                tags = {tag['Key']: tag['Value'] for tag in instance.get('Tags', [])}
                
                # Group by Name tag
                if 'Name' in tags:
                    name_group = f"tag_Name_{tags['Name'].replace(' ', '_').replace('-', '_')}"
                    if name_group not in groups:
                        groups[name_group] = []
                    groups[name_group].append(host_ip)
                
                # Group by Environment tag
                if 'Environment' in tags:
                    env_group = f"env_{tags['Environment']}"
                    if env_group not in groups:
                        groups[env_group] = []
                    groups[env_group].append(host_ip)
                
                # Group by Role tag
                if 'Role' in tags:
                    role_group = f"role_{tags['Role']}"
                    if role_group not in groups:
                        groups[role_group] = []
                    groups[role_group].append(host_ip)
                
                # Group by instance type
                type_group = f"type_{instance_type.replace('.', '_')}"
                if type_group not in groups:
                    groups[type_group] = []
                groups[type_group].append(host_ip)
                
                # Add tags to hostvars
                for key, value in tags.items():
                    inventory['_meta']['hostvars'][host_ip][f'ec2_tag_{key}'] = value
        
        # Add groups to inventory
        for group_name, hosts in groups.items():
            inventory[group_name] = {
                'hosts': hosts
            }
            
        return inventory
        
    except ClientError as e:
        print(f"Error connecting to AWS: {e}", file=sys.stderr)
        return {'_meta': {'hostvars': {}}}
    except Exception as e:
        print(f"Unexpected error: {e}", file=sys.stderr)
        return {'_meta': {'hostvars': {}}}

def main():
    """Main function to handle command line arguments"""
    if len(sys.argv) == 2 and sys.argv[1] == '--list':
        inventory = get_ec2_instances()
        print(json.dumps(inventory, indent=2))
    elif len(sys.argv) == 3 and sys.argv[1] == '--host':
        # Return empty dict for host-specific vars (we use _meta)
        print(json.dumps({}))
    else:
        print("Usage: aws_ec2_inventory.py --list")
        print("       aws_ec2_inventory.py --host <hostname>")
        sys.exit(1)

if __name__ == '__main__':
    main()
Make the script executable:
chmod +x aws_ec2_inventory.py
Subtask 2.4: Create Ansible Configuration for Dynamic Inventory
Create an ansible.cfg file for dynamic inventory:
nano ansible-dynamic.cfg
Add configuration for dynamic inventory:
[defaults]
inventory = aws_ec2_inventory.py
host_key_checking = False
remote_user = ec2-user
private_key_file = ~/.ssh/id_rsa
timeout = 30
gathering = smart
fact_caching = jsonfile
fact_caching_connection = /tmp/ansible_facts_cache
fact_caching_timeout = 3600

[inventory]
enable_plugins = aws_ec2, host_list, script, auto, yaml, ini, toml

[ssh_connection]
ssh_args = -o ControlMaster=auto -o ControlPersist=60s -o StrictHostKeyChecking=no
pipelining = True
Subtask 2.5: Alternative - Using Ansible AWS EC2 Plugin
Create a plugin-based inventory file:
nano aws_ec2.yml
Add AWS EC2 plugin configuration:
plugin: aws_ec2
regions:
  - us-east-1
  - us-west-2

# Only include running instances
filters:
  instance-state-name: running

# Organize hosts into groups
keyed_groups:
  # Group by instance type
  - key: instance_type
    prefix: type
    separator: "_"
  
  # Group by environment tag
  - key: tags.Environment | default('untagged')
    prefix: env
    separator: "_"
  
  # Group by role tag
  - key: tags.Role | default('norole')
    prefix: role
    separator: "_"
  
  # Group by availability zone
  - key: placement.availability_zone
    prefix: az
    separator: "_"

# Compose variables for each host
compose:
  ansible_host: public_ip_address | default(private_ip_address)
  ec2_instance_type: instance_type
  ec2_placement_az: placement.availability_zone
  ec2_security_groups: security_groups | map(attribute='group_name') | list
  ec2_vpc_id: vpc_id
  ec2_subnet_id: subnet_id

# Use tags as host variables
hostnames:
  - tag:Name
  - instance-id
  - public-ip-address
  - private-ip-address

# Cache inventory for better performance
cache: True
cache_plugin: jsonfile
cache_timeout: 3600
cache_connection: /tmp/ansible_inventory_cache
