        response_time: "{{ (ansible_date_time.epoch | int) - (start_time | int) }}"

    - name: Display performance metrics
      debug:
        msg: |
          Host: {{ inventory_hostname }}
          Ping Status: {{ 'Success' if ping_result is succeeded else 'Failed' }}
          Response Time: {{ response_time }}s
          Hostname: {{ ansible_hostname | default('Unknown') }}
      when: inventory_hostname in ansible_play_hosts[:3]  # Show first 3 hosts only
