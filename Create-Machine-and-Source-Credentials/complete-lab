Subtask 3.4: Create Advanced Test Job
Create a more complex playbook to test advanced credential features:
cat > playbooks/credential-advanced-test.yml << 'EOF'
---
- name: Advanced Credential Test
  hosts: all
  gather_facts: yes
  vars:
    test_user: testuser
    test_directory: /opt/credential-test
  
  tasks:
    - name: Create test user (requires sudo)
      user:
        name: "{{ test_user }}"
        state: present
        shell: /bin/bash
      become: yes
    
    - name: Create test directory
      file:
        path: "{{ test_directory }}"
        state: directory
        owner: "{{ test_user }}"
        group: "{{ test_user }}"
        mode: '0755'
      become: yes
    
    - name: Install package (requires sudo)
      package:
        name: htop
        state: present
      become: yes
    
    - name: Generate system report
      shell: |
        echo "=== System Report ===" > {{ test_directory }}/system-report.txt
        echo "Generated by: $(whoami)" >> {{ test_directory }}/system-report.txt
        echo "Date: $(date)" >> {{ test_directory }}/system-report.txt
        echo "Hostname: $(hostname)" >> {{ test_directory }}/system-report.txt
        echo "Uptime: $(uptime)" >> {{ test_directory }}/system-report.txt
      become: yes
      become_user: "{{ test_user }}"
    
    - name: Display report content
      slurp:
        src: "{{ test_directory }}/system-report.txt"
      register: report_content
      become: yes
    
    - name: Show report
      debug:
        msg: "{{ report_content.content | b64decode }}"
EOF
Commit and push the new playbook:
