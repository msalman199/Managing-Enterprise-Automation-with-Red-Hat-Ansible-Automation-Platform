Subtask 2.4: Create Sample Playbook Repository
If you don't have an existing repository, create one with sample content:

Create a new repository in your Git provider named ansible-playbooks.

Clone the repository locally:

git clone https://github.com/your-username/ansible-playbooks.git
cd ansible-playbooks
Create a simple test playbook:
mkdir -p playbooks
cat > playbooks/system-info.yml << 'EOF'
---
- name: Gather System Information
  hosts: all
  gather_facts: yes
  tasks:
    - name: Display hostname
      debug:
        msg: "Hostname: {{ ansible_hostname }}"
    
    - name: Display OS information
      debug:
        msg: "OS: {{ ansible_distribution }} {{ ansible_distribution_version }}"
    
    - name: Display memory information
      debug:
        msg: "Total Memory: {{ ansible_memtotal_mb }} MB"
    
    - name: Create test file
      file:
        path: /tmp/credential-test.txt
        state: touch
        mode: '0644'
      become: yes
    
    - name: Write test content
      lineinfile:
        path: /tmp/credential-test.txt
        line: "Credential test completed at {{ ansible_date_time.iso8601 }}"
      become: yes
EOF
Commit and push the playbook:
git add .
git commit -m "Add system information playbook for credential testing"
git push origin main
