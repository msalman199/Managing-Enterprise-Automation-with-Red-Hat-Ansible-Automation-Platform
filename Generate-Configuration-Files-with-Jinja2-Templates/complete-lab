cat > ~/jinja2-lab/templates/cisco_switch.j2 << 'EOF'
!
! Configuration generated by Jinja2 template
! Device: {{ hostname }}
! Generated on: {{ generation_time }}
!
hostname {{ hostname }}
!
! Management Interface Configuration
interface {{ mgmt_interface }}
 description Management Interface
 ip address {{ mgmt_ip }} {{ mgmt_subnet }}
 no shutdown
!
! VLAN Configuration
{% for vlan in vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
{% endfor %}
!
! Interface Configuration
{% for interface in interfaces %}
interface {{ interface.name }}
 description {{ interface.description }}
{% if interface.type == 'access' %}
 switchport mode access
 switchport access vlan {{ interface.vlan }}
{% elif interface.type == 'trunk' %}
 switchport mode trunk
 switchport trunk allowed vlan {{ interface.allowed_vlans | join(',') }}
{% endif %}
 no shutdown
{% endfor %}
!
! Enable SSH
ip domain-name {{ domain_name }}
crypto key generate rsa modulus 2048
ip ssh version 2
!
line vty 0 15
 transport input ssh
 login local
!
username {{ admin_user }} privilege 15 secret {{ admin_password }}
!
end
EOF

Subtask 1.3: Create a Router Configuration Template

cat > ~/jinja2-lab/templates/cisco_router.j2 << 'EOF'
!
! Router Configuration Template
! Device: {{ hostname }}
! Model: {{ device_model | default('Unknown') }}
!
hostname {{ hostname }}
!
! Interface Configuration
{% for interface in interfaces %}
interface {{ interface.name }}
 description {{ interface.description }}
{% if interface.ip_address is defined %}
 ip address {{ interface.ip_address }} {{ interface.subnet_mask }}
{% endif %}
{% if interface.type == 'wan' %}
 ip nat outside
{% elif interface.type == 'lan' %}
 ip nat inside
{% endif %}
 no shutdown
{% endfor %}
!
{% if routing.protocol == 'ospf' %}
! OSPF Configuration
router ospf {{ routing.process_id }}
{% for network in routing.networks %}
 network {{ network.network }} {{ network.wildcard }} area {{ network.area }}
{% endfor %}
{% elif routing.protocol == 'static' %}
! Static Routes
{% for route in routing.static_routes %}
ip route {{ route.destination }} {{ route.mask }} {{ route.next_hop }}
{% endfor %}
{% endif %}
!
{% if nat is defined and nat.enabled %}
! NAT Configuration
{% for rule in nat.rules %}
ip nat {{ rule.type }} {{ rule.source }} {{ rule.destination }}
{% endfor %}
{% endif %}
!
! Access Control Lists
{% for acl in access_lists %}
{% if acl.type == 'standard' %}
access-list {{ acl.number }} {{ acl.action }} {{ acl.source }}
{% elif acl.type == 'extended' %}
access-list {{ acl.number }} {{ acl.action }} {{ acl.protocol }} {{ acl.source }} {{ acl.destination }}
{% endif %}
{% endfor %}
!
end
EOF

