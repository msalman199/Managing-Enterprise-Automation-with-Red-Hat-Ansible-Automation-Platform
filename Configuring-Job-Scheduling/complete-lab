Subtask 3.6: Create Custom Notification Script
Create an advanced notification handler:

cat > /home/ansible/monitoring-scripts/notification-handler.py << 'EOF'
#!/usr/bin/env python3

import smtplib
import json
import requests
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart
from datetime import datetime

class NotificationHandler:
    def __init__(self, config_file='notification-config.json'):
        with open(config_file, 'r') as f:
            self.config = json.load(f)
    
    def send_email(self, subject, body, recipients=None):
        """Send email notification"""
        if not recipients:
            recipients = self.config['email']['default_recipients']
        
        msg = MIMEMultipart()
        msg['From'] = self.config['email']['sender']
        msg['To'] = ', '.join(recipients)
        msg['Subject'] = subject
        
        msg.attach(MIMEText(body, 'html'))
        
        try:
            server = smtplib.SMTP(self.config['email']['smtp_host'], 
                                self.config['email']['smtp_port'])
            server.starttls()
            server.login(self.config['email']['username'], 
                       self.config['email']['password'])
            server.send_message(msg)
            server.quit()
            print(f"Email sent successfully to {recipients}")
        except Exception as e:
            print(f"Failed to send email: {e}")
    
    def send_slack_message(self, message, channel=None):
        """Send Slack notification"""
        if not channel:
            channel = self.config['slack']['default_channel']
        
        webhook_url = self.config['slack']['webhook_url']
        payload = {
            'channel': channel,
            'text': message,
            'username': 'Ansible AWX',
            'icon_emoji': ':robot_face:'
        }
        
        try:
            response = requests.post(webhook_url, json=payload)
            response.raise_for_status()
            print(f"Slack message sent to {channel}")
        except Exception as e:
            print(f"Failed to send Slack message: {e}")
    
    def format_job_notification(self, job_data, status):
        """Format job notification message"""
        job_id = job_data.get('id', 'Unknown')
        job_name = job_data.get('name', 'Unknown Job')
        started = job_data.get('started', 'Unknown')
        finished = job_data.get('finished', 'In Progress')
        
        if status == 'success':
            emoji = '✅'
            color = 'good'
        elif status == 'failure':
            emoji = '❌'
            color = 'danger'
        else:
            emoji = '⏳'
            color = 'warning'
        
        message = f"""
        {emoji} **Ansible Job {status.title()}**
        
        **Job Details:**
        - Job ID: {job_id}
        - Job Name: {job_name}
        - Status: {status.title()}
        - Started: {started}
        - Finished: {finished}
        
        **Actions:**
        - View job details in AWX dashboard
        - Check logs for more information
        """
        
        return message
    
    def notify_job_status(self, job_data, status):
        """Send notifications for job status"""
        message = self.format_job_notification(job_data, status)
        
        # Send email for failures and successes
        if status in ['success', 'failure']:
            subject = f"Ansible Job {status.title()}: {job_data.get('name', 'Unknown')}"
            self.send_email(subject, message)
        
        # Send Slack for all status updates
        self.send_slack_message(message)

# Example usage
if __name__ == "__main__":
    # Sample job data
    job_data = {
        'id': 123,
        'name': 'Daily System Maintenance',
        'status': 'successful',
        'started': '2024-01-15T02:00:00Z',
        'finished': '2024-01-15T02:15:00Z'
    }
    
    handler = NotificationHandler()
    handler.notify_job_status(job_data, 'success')
EOF
