Task 1: Install Ansible Automation Controller (AWX)
Ansible Automation Controller is the web-based user interface and REST API for Ansible. We'll use AWX, which is the open-source upstream project for Automation Controller.

Subtask 1.1: Prepare the System Environment
First, let's ensure our system is updated and has all necessary dependencies.

# Update the system packages
sudo dnf update -y

# Install required packages
sudo dnf install -y git curl wget python3 python3-pip nodejs npm

# Install Docker Compose
sudo curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
sudo chmod +x /usr/local/bin/docker-compose

# Verify Docker Compose installation
docker-compose --version
Subtask 1.2: Clone AWX Repository
# Navigate to home directory
cd ~

# Clone the AWX repository
git clone https://github.com/ansible/awx.git

# Navigate to AWX directory
cd awx

# Check available tags and use the latest stable version
git tag | tail -10
git checkout $(git tag | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1)
Subtask 1.3: Configure AWX Installation
# Navigate to the installer directory
cd ~/awx/tools/docker-compose

# Create a custom inventory file
cp inventory.example inventory

# Edit the inventory file with basic configuration
cat > inventory << 'EOF'
# AWX Configuration
admin_user=admin
admin_password=ansible123
secret_key=awxsecretkey123456789
database_name=awx
database_user=awx
database_password=awxpass
database_host=postgres
database_port=5432

# Docker configuration
docker_compose_dir=/tmp/awxcompose
pg_username=awx
pg_password=awxpass
pg_database=awx
pg_port=5432

# Web configuration
host_port=8080
host_port_ssl=8443

# Project directory
project_data_dir=/tmp/awx_projects
EOF
Subtask 1.4: Install and Start AWX
# Make the installation script executable
chmod +x install.sh

# Run the AWX installation
./install.sh

# Wait for installation to complete (this may take 10-15 minutes)
# Monitor the installation progress
docker-compose -f /tmp/awxcompose/docker-compose.yml logs -f
Subtask 1.5: Verify AWX Installation
# Check if all containers are running
docker ps

# Verify AWX is accessible
curl -k http://localhost:8080

# Check AWX logs for any errors
docker-compose -f /tmp/awxcompose/docker-compose.yml logs awx_web
Task 2: Install Automation Hub (Pulp)
Automation Hub serves as a repository for Ansible content including collections, execution environments, and other automation assets. We'll install Pulp, the open-source project that powers Automation Hub.

Subtask 2.1: Install Pulp Dependencies
# Install Python virtual environment tools
sudo dnf install -y python3-venv python3-devel gcc

# Install PostgreSQL for Pulp database
sudo dnf install -y postgresql postgresql-server postgresql-devel

# Initialize PostgreSQL
sudo postgresql-setup --initdb
sudo systemctl enable postgresql
sudo systemctl start postgresql

# Install Redis for Pulp caching
sudo dnf install -y redis
sudo systemctl enable redis
sudo systemctl start redis
Subtask 2.2: Configure PostgreSQL for Pulp
# Switch to postgres user and create database
sudo -u postgres psql << 'EOF'
CREATE DATABASE pulp;
CREATE USER pulp WITH PASSWORD 'pulppassword';
GRANT ALL PRIVILEGES ON DATABASE pulp TO pulp;
ALTER USER pulp CREATEDB;
\q
EOF

# Configure PostgreSQL authentication
sudo sed -i "s/#listen_addresses = 'localhost'/listen_addresses = '*'/" /var/lib/pgsql/data/postgresql.conf
echo "host pulp pulp 127.0.0.1/32 md5" | sudo tee -a /var/lib/pgsql/data/pg_hba.conf

# Restart PostgreSQL
sudo systemctl restart postgresql
Subtask 2.3: Install Pulp using pip
# Create a dedicated user for Pulp
sudo useradd --system --shell /bin/bash --home-dir /var/lib/pulp --create-home pulp

# Create Python virtual environment
sudo -u pulp python3 -m venv /var/lib/pulp/pulpvenv

# Activate virtual environment and install Pulp
sudo -u pulp /var/lib/pulp/pulpvenv/bin/pip install --upgrade pip setuptools wheel

# Install Pulp core and Ansible plugin
sudo -u pulp /var/lib/pulp/pulpvenv/bin/pip install pulpcore[postgres]
sudo -u pulp /var/lib/pulp/pulpvenv/bin/pip install pulp-ansible
sudo -u pulp /var/lib/pulp/pulpvenv/bin/pip install pulp-container
Subtask 2.4: Configure Pulp Settings
# Create Pulp configuration directory
sudo mkdir -p /etc/pulp

# Create Pulp settings file
sudo tee /etc/pulp/settings.py << 'EOF'
CONTENT_ORIGIN = "http://$(hostname -f):24816"
ALLOWED_HOSTS = ["*"]
SECRET_KEY = "pulp-secret-key-change-me"

DATABASES = {
    'default': {
        'ENGINE': 'django.db.backends.postgresql',
        'NAME': 'pulp',
        'USER': 'pulp',
        'PASSWORD': 'pulppassword',
        'HOST': 'localhost',
        'PORT': '5432',
    }
}

REDIS_URL = "redis://localhost:6379/0"

STATIC_ROOT = "/var/lib/pulp/static/"
MEDIA_ROOT = "/var/lib/pulp/media/"
WORKING_DIRECTORY = "/tmp/pulp-tmp"

ANSIBLE_API_HOSTNAME = "http://localhost:24817"
ANSIBLE_CONTENT_HOSTNAME = "http://localhost:24816/pulp/content"
EOF

# Set proper ownership
sudo chown pulp:pulp /etc/pulp/settings.py
Subtask 2.5: Initialize and Start Pulp Services
# Run database migrations
sudo -u pulp PULP_SETTINGS=/etc/pulp/settings.py /var/lib/pulp/pulpvenv/bin/pulpcore-manager migrate --noinput

# Collect static files
sudo -u pulp PULP_SETTINGS=/etc/pulp/settings.py /var/lib/pulp/pulpvenv/bin/pulpcore-manager collectstatic --noinput

# Create admin user
sudo -u pulp PULP_SETTINGS=/etc/pulp/settings.py /var/lib/pulp/pulpvenv/bin/pulpcore-manager createsuperuser --username admin --email admin@example.com --noinput
sudo -u pulp PULP_SETTINGS=/etc/pulp/settings.py /var/lib/pulp/pulpvenv/bin/pulpcore-manager shell -c "from django.contrib.auth import get_user_model; User = get_user_model(); u = User.objects.get(username='admin'); u.set_password('admin123'); u.save()"
Subtask 2.6: Create Pulp Service Files
# Create systemd service for Pulp API
sudo tee /etc/systemd/system/pulpcore-api.service << 'EOF'
[Unit]
Description=Pulp WSGI Server
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=pulp
Group=pulp
Environment=PULP_SETTINGS=/etc/pulp/settings.py
WorkingDirectory=/var/lib/pulp
ExecStart=/var/lib/pulp/pulpvenv/bin/gunicorn pulpcore.app.wsgi:application --bind 127.0.0.1:24817 --access-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

# Create systemd service for Pulp Content
sudo tee /etc/systemd/system/pulpcore-content.service << 'EOF'
[Unit]
Description=Pulp Content Server
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=pulp
Group=pulp
Environment=PULP_SETTINGS=/etc/pulp/settings.py
WorkingDirectory=/var/lib/pulp
ExecStart=/var/lib/pulp/pulpvenv/bin/gunicorn pulpcore.content:server --bind 127.0.0.1:24816 --access-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

# Create systemd service for Pulp Worker
sudo tee /etc/systemd/system/pulpcore-worker@.service << 'EOF'
[Unit]
Description=Pulp Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=pulp
Group=pulp
Environment=PULP_SETTINGS=/etc/pulp/settings.py
WorkingDirectory=/var/lib/pulp
ExecStart=/var/lib/pulp/pulpvenv/bin/rq worker -w pulpcore.tasking.worker.PulpWorker -c pulpcore.rqconfig
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

# Reload systemd and start services
sudo systemctl daemon-reload
sudo systemctl enable pulpcore-api pulpcore-content pulpcore-worker@1
sudo systemctl start pulpcore-api pulpcore-content pulpcore-worker@1
