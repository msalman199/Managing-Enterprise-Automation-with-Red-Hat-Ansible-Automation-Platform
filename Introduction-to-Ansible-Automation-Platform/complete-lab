Troubleshooting Common Issues
AWX Installation Issues
Problem: AWX containers fail to start

# Check Docker service status
sudo systemctl status docker

# Check available disk space
df -h

# Review AWX logs
docker-compose -f /tmp/awxcompose/docker-compose.yml logs
Problem: Cannot access AWX web interface

# Check if AWX is listening on correct port
sudo netstat -tlnp | grep 8080

# Verify firewall settings
sudo firewall-cmd --list-all

# Check AWX web container logs
docker logs awx_web
Pulp Installation Issues
Problem: Pulp services fail to start

# Check PostgreSQL connection
sudo -u pulp PULP_SETTINGS=/etc/pulp/settings.py /var/lib/pulp/pulpvenv/bin/pulpcore-manager shell -c "from django.db import connection; connection.ensure_connection(); print('Database connection successful')"

# Check Redis connection
redis-cli ping

# Review service logs
sudo journalctl -u pulpcore-api -f
Problem: Permission errors

# Fix ownership of Pulp directories
sudo chown -R pulp:pulp /var/lib/pulp
sudo chown -R pulp:pulp /etc/pulp

# Check SELinux status (if enabled)
sudo getenforce
sudo setsebool -P httpd_can_network_connect 1
