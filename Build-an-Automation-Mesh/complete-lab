Subtask 3.2: Create Test Playbook Project
Create a project with test playbooks:

# Create project directory
mkdir -p /tmp/mesh-test-playbooks

# Create a simple test playbook
cat > /tmp/mesh-test-playbooks/mesh-test.yml << 'EOF'
---
- name: Mesh Execution Test
  hosts: all
  gather_facts: yes
  tasks:
    - name: Display node information
      debug:
        msg: |
          Executing on: {{ inventory_hostname }}
          Ansible node: {{ ansible_hostname }}
          Execution node: {{ ansible_env.HOSTNAME | default('unknown') }}
          Date/Time: {{ ansible_date_time.iso8601 }}
          
    - name: Create test file
      file:
        path: /tmp/mesh-test-{{ ansible_date_time.epoch }}.txt
        state: touch
        mode: '0644'
      
    - name: Write execution details
      lineinfile:
        path: /tmp/mesh-test-{{ ansible_date_time.epoch }}.txt
        line: "Job executed on {{ inventory_hostname }} at {{ ansible_date_time.iso8601 }}"
        create: yes

    - name: Test network connectivity
      uri:
        url: "http://httpbin.org/ip"
        method: GET
      register: network_test
      
    - name: Display network test results
      debug:
        var: network_test.json
EOF

# Create performance test playbook
cat > /tmp/mesh-test-playbooks/performance-test.yml << 'EOF'
---
- name: Mesh Performance Test
  hosts: all
  gather_facts: yes
  tasks:
    - name: CPU intensive task
      shell: |
        start_time=$(date +%s)
        for i in {1..1000}; do
          echo "Processing iteration $i" > /dev/null
        done
        end_time=$(date +%s)
        echo "Task completed in $((end_time - start_time)) seconds"
      register: cpu_test
      
    - name: Display performance results
      debug:
        var: cpu_test.stdout
        
    - name: Memory usage check
      shell: free -h
      register: memory_check
      
    - name: Display memory usage
      debug:
        var: memory_check.stdout_lines
EOF
