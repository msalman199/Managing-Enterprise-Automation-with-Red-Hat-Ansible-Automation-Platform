Subtask 3.5: Execute Test Jobs
Launch test jobs and monitor execution:

# Get job template IDs
BASIC_TEMPLATE_ID=$(curl -k -X GET "${CONTROLLER_HOST}/api/v2/job_templates/" \
    -H "Authorization: Bearer ${TOKEN}" | jq -r '.results[] | select(.name=="Mesh Basic Test") | .id')

PERF_TEMPLATE_ID=$(curl -k -X GET "${CONTROLLER_HOST}/api/v2/job_templates/" \
    -H "Authorization: Bearer ${TOKEN}" | jq -r '.results[] | select(.name=="Mesh Performance Test") | .id')

# Launch basic test job
BASIC_JOB_ID=$(curl -k -X POST "${CONTROLLER_HOST}/api/v2/job_templates/${BASIC_TEMPLATE_ID}/launch/" \
    -H "Authorization: Bearer ${TOKEN}" \
    -H "Content-Type: application/json" \
    -d '{}' | jq -r '.id')

echo "Basic test job launched with ID: ${BASIC_JOB_ID}"

# Monitor job status
while true; do
    STATUS=$(curl -k -X GET "${CONTROLLER_HOST}/api/v2/jobs/${BASIC_JOB_ID}/" \
        -H "Authorization: Bearer ${TOKEN}" | jq -r '.status')
    echo "Job status: ${STATUS}"
    if [[ "${STATUS}" == "successful" || "${STATUS}" == "failed" || "${STATUS}" == "error" ]]; then
        break
    fi
    sleep 5
done

# Launch performance test job
PERF_JOB_ID=$(curl -k -X POST "${CONTROLLER_HOST}/api/v2/job_templates/${PERF_TEMPLATE_ID}/launch/" \
    -H "Authorization: Bearer ${TOKEN}" \
    -H "Content-Type: application/json" \
