Subtask 2.4: Configure Mesh Networking
Set up the mesh networking configuration:

# Create mesh configuration file
cat > /tmp/mesh-config.yml << 'EOF'
---
mesh_config:
  controller_nodes:
    - hostname: controller-node
      ip: 10.0.1.10
      
  execution_nodes:
    - hostname: execution-node-1
      ip: 10.0.1.11
      peers:
        - execution-node-2
        - hop-node
    - hostname: execution-node-2
      ip: 10.0.1.12
      peers:
        - execution-node-1
        - hop-node
        
  hop_nodes:
    - hostname: hop-node
      ip: 10.0.1.13
      peers:
        - execution-node-1
        - execution-node-2

  network_settings:
    receptor_port: 27199
    control_service_port: 8013
    work_signing_private_keyfile: /etc/automation-mesh/certs/work-signing-private.pem
    work_signing_public_keyfile: /etc/automation-mesh/certs/work-signing-public.pem
EOF
Subtask 2.5: Deploy Mesh Configuration
Deploy the mesh configuration to all nodes:

# Copy configuration to all nodes
for node in execution-node-1 execution-node-2 hop-node; do
    scp /tmp/mesh-config.yml ${node}:/tmp/
    ssh ${node} "sudo mv /tmp/mesh-config.yml /etc/automation-mesh/"
done

# Restart receptor service on all mesh nodes
for node in execution-node-1 execution-node-2 hop-node; do
    ssh ${node} "sudo systemctl restart receptor"
    ssh ${node} "sudo systemctl enable receptor"
done
