Subtask 3.7: Monitor Mesh Performance
Create monitoring scripts to track mesh performance:

# Create mesh monitoring script
cat > /tmp/mesh-monitor.sh << 'EOF'
#!/bin/bash

echo "=== Automation Mesh Status Report ==="
echo "Generated at: $(date)"
echo ""

# Check controller status
echo "--- Controller Node Status ---"
systemctl is-active automation-controller-web
systemctl is-active automation-controller-task
echo ""

# Check execution nodes
for node in execution-node-1 execution-node-2; do
    echo "--- ${node} Status ---"
    ssh ${node} "systemctl is-active receptor"
    ssh ${node} "ps aux | grep receptor | grep -v grep | wc -l"
    echo ""
done

# Check hop node
echo "--- Hop Node Status ---"
ssh hop-node "systemctl is-active receptor"
ssh hop-node "ps aux | grep receptor | grep -v grep | wc -l"
echo ""

# Network connectivity test
echo "--- Network Connectivity ---"
for node in execution-node-1 execution-node-2 hop-node; do
    echo "Ping to ${node}: $(ping -c 1 ${node} >/dev/null 2>&1 && echo 'OK' || echo 'FAILED')"
done
echo ""

# Recent job execution summary
echo "--- Recent Job Summary ---"
curl -k -s -X GET "${CONTROLLER_HOST}/api/v2/jobs/?page_size=5" \
    -H "Authorization: Bearer ${TOKEN}" | \
    jq -r '.results[] | "\(.id): \(.name) - \(.status) on \(.execution_node // "controller")"'
EOF

chmod +x /tmp/mesh-monitor.sh
/tmp/mesh-monitor.sh
Troubleshooting Common Issues
Issue 1: Receptor Service Not Starting
# Check receptor configuration
sudo cat /etc/receptor/receptor.conf

# Check receptor logs
sudo journalctl -u receptor -f

# Restart receptor with debug logging
sudo systemctl stop receptor
sudo receptor --config /etc/receptor/receptor.conf --log-level debug
Issue 2: Mesh Nodes Not Communicating
# Check firewall settings
sudo firewall-cmd --list-all

# Open required ports
sudo firewall-cmd --permanent --add-port=27199/tcp
sudo firewall-cmd --permanent --add-port=8013/tcp
sudo firewall-cmd --reload

# Test network connectivity
telnet execution-node-1 27199
Issue 3: Jobs Not Distributing Across Nodes
# Check instance group configuration
curl -k -X GET "${CONTROLLER_HOST}/api/v2/instance_groups/" \
    -H "Authorization: Bearer ${TOKEN}" | jq '.results'

# Verify node capacity
curl -k -X GET "${CONTROLLER_HOST}/api/v2/instances/" \
    -H "Authorization: Bearer ${TOKEN}" | jq '.results[] | {hostname, capacity, enabled}'
