Subtask 1.5: Generate SSL Certificates for Mesh
Create SSL certificates for secure mesh communication:

# Create certificate directory
sudo mkdir -p /etc/automation-mesh/certs

# Generate CA certificate
sudo openssl genrsa -out /etc/automation-mesh/certs/ca-key.pem 4096
sudo openssl req -new -x509 -days 365 -key /etc/automation-mesh/certs/ca-key.pem \
    -out /etc/automation-mesh/certs/ca.pem -subj "/CN=Automation-Mesh-CA"

# Generate node certificates for each mesh node
for node in controller-node execution-node-1 execution-node-2 hop-node; do
    sudo openssl genrsa -out /etc/automation-mesh/certs/${node}-key.pem 2048
    sudo openssl req -new -key /etc/automation-mesh/certs/${node}-key.pem \
        -out /etc/automation-mesh/certs/${node}.csr -subj "/CN=${node}"
    sudo openssl x509 -req -days 365 -in /etc/automation-mesh/certs/${node}.csr \
        -CA /etc/automation-mesh/certs/ca.pem -CAkey /etc/automation-mesh/certs/ca-key.pem \
        -CAcreateserial -out /etc/automation-mesh/certs/${node}.pem
done
