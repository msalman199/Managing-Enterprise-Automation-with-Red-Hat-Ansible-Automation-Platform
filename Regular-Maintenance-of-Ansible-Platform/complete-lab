Subtask 1.3: Update Automation Controller Components
Stop Automation Controller services in the correct order:
# Create a service management script
cat > /tmp/manage_services.sh << 'EOF'
#!/bin/bash

ACTION=$1
SERVICES=("automation-controller-web" "automation-controller-task" "automation-controller-callback-receiver")

case $ACTION in
    "stop")
        echo "Stopping Automation Controller services..."
        for service in "${SERVICES[@]}"; do
            echo "Stopping $service"
            sudo systemctl stop $service
            sleep 2
        done
        ;;
    "start")
        echo "Starting Automation Controller services..."
        for service in "${SERVICES[@]}"; do
            echo "Starting $service"
            sudo systemctl start $service
            sleep 5
        done
        ;;
    "status")
        echo "Checking service status..."
        for service in "${SERVICES[@]}"; do
            systemctl is-active $service
        done
        ;;
esac
EOF

chmod +x /tmp/manage_services.sh

