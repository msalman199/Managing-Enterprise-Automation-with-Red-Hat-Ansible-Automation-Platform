Task 3: Schedule Regular Maintenance Tasks
Subtask 3.1: Create Automated Backup Scripts
Create comprehensive backup script:
cat > /opt/ansible-backup.sh << 'EOF'
#!/bin/bash

# Ansible Platform Backup Script
BACKUP_BASE="/opt/ansible-backups"
DATE=$(date +%Y%m%d-%H%M%S)
BACKUP_DIR="$BACKUP_BASE/backup-$DATE"
LOG_FILE="/var/log/ansible-backup.log"

# Create backup directory
mkdir -p $BACKUP_DIR

echo "$(date): Starting backup to $BACKUP_DIR" >> $LOG_FILE

# Backup database
echo "$(date): Backing up database..." >> $LOG_FILE
sudo -u postgres pg_dump awx > $BACKUP_DIR/awx-database.sql
if [ $? -eq 0 ]; then
    echo "$(date): Database backup completed successfully" >> $LOG_FILE
else
    echo "$(date): Database backup failed" >> $LOG_FILE
    exit 1
fi

# Backup configuration files
echo "$(date): Backing up configuration files..." >> $LOG_FILE
cp -r /etc/tower/ $BACKUP_DIR/tower-config/ 2>/dev/null
cp -r /etc/nginx/ $BACKUP_DIR/nginx-config/ 2>/dev/null
cp -r /etc/postgresql/ $BACKUP_DIR/postgresql-config/ 2>/dev/null

# Backup custom playbooks and inventories
if [ -d "/var/lib/awx/projects" ]; then
    cp -r /var/lib/awx/projects/ $BACKUP_DIR/projects/ 2>/dev/null
fi

# Create backup manifest
cat > $BACKUP_DIR/backup-manifest.txt << MANIFEST
Backup Date: $(date)
Backup Directory: $BACKUP_DIR
Contents:
- AWX Database (awx-database.sql)
- Tower Configuration (/etc/tower/)
- Nginx Configuration (/etc/nginx/)
- PostgreSQL Configuration (/etc/postgresql/)
- Custom Projects (/var/lib/awx/projects/)

Backup Size: $(du -sh $BACKUP_DIR | cut -f1)
MANIFEST

# Compress backup
echo "$(date): Compressing backup..." >> $LOG_FILE
cd $BACKUP_BASE
tar -czf backup-$DATE.tar.gz backup-$DATE/
rm -rf backup-$DATE/

# Clean old backups (keep last 7 days)
find $BACKUP_BASE -name "backup-*.tar.gz" -mtime +7 -delete

echo "$(date): Backup completed successfully" >> $LOG_FILE
echo "Backup file: $BACKUP_BASE/backup-$DATE.tar.gz"
EOF

chmod +x /opt/ansible-backup.sh
