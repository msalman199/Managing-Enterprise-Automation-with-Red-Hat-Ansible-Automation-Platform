Create a monitoring script for Ansible services:
cat > /opt/ansible-monitor.sh << 'EOF'
#!/bin/bash

# Ansible Platform Monitoring Script
LOG_FILE="/var/log/ansible-monitoring.log"
DATE=$(date '+%Y-%m-%d %H:%M:%S')

echo "=== Ansible Platform Health Check - $DATE ===" >> $LOG_FILE

# Check service status
echo "Service Status:" >> $LOG_FILE
systemctl is-active automation-controller-web >> $LOG_FILE 2>&1
systemctl is-active automation-controller-task >> $LOG_FILE 2>&1
systemctl is-active pulpcore-api >> $LOG_FILE 2>&1
systemctl is-active postgresql >> $LOG_FILE 2>&1
systemctl is-active nginx >> $LOG_FILE 2>&1
systemctl is-active redis >> $LOG_FILE 2>&1

# Check resource usage
echo "Resource Usage:" >> $LOG_FILE
echo "CPU Usage: $(top -bn1 | grep "Cpu(s)" | awk '{print $2}' | cut -d'%' -f1)" >> $LOG_FILE
echo "Memory Usage: $(free | grep Mem | awk '{printf "%.2f%%", $3/$2 * 100.0}')" >> $LOG_FILE
echo "Disk Usage: $(df -h / | awk 'NR==2{printf "%s", $5}')" >> $LOG_FILE

# Check database connections
echo "Database Connections:" >> $LOG_FILE
sudo -u postgres psql -c "SELECT count(*) as active_connections FROM pg_stat_activity WHERE state = 'active';" >> $LOG_FILE 2>&1

# Check API responsiveness
echo "API Health:" >> $LOG_FILE
curl -s -k https://localhost/api/v2/ping/ | grep -q "pong" && echo "Controller API: OK" >> $LOG_FILE || echo "Controller API: ERROR" >> $LOG_FILE

echo "===========================================" >> $LOG_FILE
echo "" >> $LOG_FILE
EOF

