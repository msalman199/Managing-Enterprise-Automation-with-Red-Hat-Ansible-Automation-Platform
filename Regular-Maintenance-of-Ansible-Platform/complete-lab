Subtask 3.4: Set Up Health Checks and Alerts
Create comprehensive health check script:
cat > /opt/health-check.sh << 'EOF'
#!/bin/bash

# Comprehensive Health Check Script
ALERT_EMAIL="admin@localhost"
LOG_FILE="/var/log/ansible-health-check.log"
ALERT_LOG="/var/log/ansible-alerts.log"

# Function to send alert
send_alert() {
    local message="$1"
    echo "$(date): ALERT - $message" >> $ALERT_LOG
    echo "$message" | mail -s "Ansible Platform Alert" $ALERT_EMAIL 2>/dev/null
}

# Function to log status
log_status() {
    local message="$1"
    echo "$(date): $message" >> $LOG_FILE
}

log_status "Starting health check..."

# Check critical services
critical_services=("automation-controller-web" "automation-controller-task" "postgresql" "nginx" "redis")
for service in "${critical_services[@]}"; do
    if ! systemctl is-active --quiet $service; then
        send_alert "Critical service $service is not running"
        log_status "CRITICAL: $service is down"
    else
        log_status "OK: $service is running"
    fi
done

# Check disk space
disk_usage=$(df / | awk 'NR==2{print $5}' | sed 's/%//')
if [ $disk_usage -gt 85 ]; then
    send_alert "Disk space critical: ${disk_usage}% used"
    log_status "CRITICAL: Disk space at ${disk_usage}%"
else
    log_status "OK: Disk space at ${disk_usage}%"
fi

# Check memory usage
memory_usage=$(free | grep Mem | awk '{printf "%.0f", $3/$2 * 100.0}')
if [ $memory_usage -gt 90 ]; then
    send_alert "Memory usage critical: ${memory_usage}% used"
    log_status "CRITICAL: Memory usage at ${memory_usage}%"
else
    log_status "OK: Memory usage at ${memory_usage}%"
fi

# Check database connectivity
if ! sudo -u postgres psql -d awx -c "SELECT 1;" > /dev/null 2>&1; then
    send_alert "Database connectivity failed"
    log_status "CRITICAL: Cannot connect to database"
else
    log_status "OK: Database connectivity verified"
fi

# Check API responsiveness
if ! curl -s -k https://localhost/api/v2/ping/ | grep -q "pong"; then
    send_alert "Controller API is not responding"
    log_status "CRITICAL: Controller API not responding"
else
    log_status "OK: Controller API responding"
fi

# Check certificate expiration (if using HTTPS)
cert_days=$(echo | openssl s_client -servername localhost -connect localhost:443 2>/dev/null | openssl x509 -noout -dates | grep notAfter | cut -d= -f2 | xargs -I {} date -d {} +%s)
current_time=$(date +%s)
days_until_expiry=$(( (cert_days - current_time) / 86400 ))

if [ $days_until_expiry -lt 30 ]; then
    send_alert "SSL certificate expires in $days_until_expiry days"
    log_status "WARNING: SSL certificate expires in $days_until_expiry days"
else
    log_status "OK: SSL certificate valid for $days_until_expiry days"
fi

log_status "Health check completed"
EOF

