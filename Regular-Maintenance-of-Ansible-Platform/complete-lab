cat > /opt/db-maintenance.sh << 'EOF'
#!/bin/bash

# Database Maintenance Script
LOG_FILE="/var/log/ansible-db-maintenance.log"

echo "$(date): Starting database maintenance..." >> $LOG_FILE

# Vacuum and analyze database
sudo -u postgres psql -d awx -c "VACUUM ANALYZE;" >> $LOG_FILE 2>&1

